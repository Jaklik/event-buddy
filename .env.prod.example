# Zkopíruj na serveru do .env vedle docker-compose.prod.yml a nastav práva: chmod 600 .env
# Soubor .env necommituj a hodnoty z něj nikam nevkládej (chat, tickety, logy). Zdroj pravdy je password manager.
# Hodnoty nikdy nepiš do příkazové řádky (zůstanou v historii shellu); edituj soubor v editoru.
#
# Každé heslo vygeneruj zvlášť: openssl rand -hex 24
# Hex je vhodný, protože heslo je součástí adresy databáze a nesmí obsahovat speciální znaky.
# Úplný přehled proměnných a postup rotace: event-buddy/project/env-variables.md

# Superuživatel databáze: slouží jen správě a zálohám, aplikace se pod ním nepřipojuje.
POSTGRES_PASSWORD=
# Role migrator (migrace, schéma) a app (API, jen čtení a zápis dat).
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
# POSTGRES_USER=selfplan
# POSTGRES_DB=selfplan

# Pozor: hesla se do databáze zapíšou jen při prvním startu s prázdným svazkem. Pozdější změna hodnoty
# v tomto souboru heslo v existující databázi nezmění (viz postup rotace v env-variables.md).

# Origin webu, který smí volat API (včetně portu). Přes SSH tunel: http://localhost:3100
CORS_ORIGIN=http://localhost:3100

# Přes http (SSH tunel) false, s HTTPS true (výchozí).
SESSION_COOKIE_SECURE=false

# Počet reverzních proxy před API (Caddy = 1). Bez proxy 0, jinak by šla podvrhnout IP klienta.
TRUST_PROXY=0

# Kanonická adresa webu. Veřejná hodnota, nikdy sem nepatří secret (NUXT_PUBLIC_* jde do prohlížeče).
NUXT_PUBLIC_SITE_URL=http://localhost:3100
