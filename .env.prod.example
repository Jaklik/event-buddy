# Zkopíruj na serveru do .env vedle docker-compose.prod.yml a nastav práva: chmod 600 .env
# Soubor .env necommituj a neposílej ho do chatu. Hodnoty drž v password manageru.

# Heslo databáze. Vygeneruj: openssl rand -hex 24
# Hex je vhodný, protože heslo je součástí adresy DATABASE_URL a nesmí obsahovat speciální znaky.
POSTGRES_PASSWORD=
# POSTGRES_USER=selfplan
# POSTGRES_DB=selfplan

# Origin webu, který smí volat API (včetně portu). Přes SSH tunel: http://localhost:3100
CORS_ORIGIN=http://localhost:3100

# Přes http (SSH tunel) false, s HTTPS true (výchozí).
SESSION_COOKIE_SECURE=false

# Počet reverzních proxy před API (Caddy = 1). Bez proxy 0, jinak by šla podvrhnout IP klienta.
TRUST_PROXY=0

# Kanonická adresa webu.
NUXT_PUBLIC_SITE_URL=http://localhost:3100
