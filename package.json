{
  "name": "selfplan",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "dev:web": "pnpm --filter @selfplan/web dev",
    "dev:api": "pnpm --filter @selfplan/api dev",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "test": "pnpm -r --if-present test",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:secrets:selftest": "bash scripts/check-secrets.selftest.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "body-parser": "^2.4.0",
      "multer": "^2.5.0",
      "deepmerge-ts": "^8.0.0"
    }
  }
}
